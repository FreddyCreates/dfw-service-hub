 };
type MatchProvidersInput = 
 record {
   category: opt text;
   need: text;
   serviceArea: opt text;
 };
type MarketplaceRole = 
 variant {
   admin;
   customer;
   provider;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DocStatus = 
 variant {
   draft;
   published;
 };
type DocInput = 
 record {
   category: text;
   content: text;
   slug: text;
   status: DocStatus;
   title: text;
 };
type Doc = 
 record {
   author: UserId;
   category: text;
   content: text;
   createdAt: Timestamp;
   id: nat;
   readingTime: nat;
   slug: text;
   status: DocStatus;
   title: text;
   updatedAt: Timestamp;
 };
type DisputeTriage = 
 record {
   disputeId: nat;
   rationale: text;
   severity: text;
   suggestedResolution: text;
 };
type DisputeStatus = 
 variant {
   escalated;
   open;
   resolved;
   responded;
 };
type DisputeInput = 
 record {
