 };
type Microsite = 
 record {
   aboutCopy: text;
   accentColor: opt text;
   blockOrder: vec text;
   coverImage: opt blob;
   createdAt: Timestamp;
   generatedAt: opt Timestamp;
   heroCopy: text;
