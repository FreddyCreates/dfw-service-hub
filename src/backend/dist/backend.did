type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type VerificationStatus = 
 variant {
   approved;
   pending;
   rejected;
   suspended;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserInput = 
 record {
   avatar: opt ExternalBlob;
   displayName: text;
   email: opt text;
   phone: opt text;
   role: MarketplaceRole;
 };
type UserId = principal;
type User = 
 record {
   avatar: opt ExternalBlob;
   createdAt: Timestamp;
   displayName: text;
   email: opt text;
   phone: opt text;
   "principal": UserId;
   role: MarketplaceRole;
   updatedAt: Timestamp;
 };
type Timestamp = int;
type SlotStatus = 
 variant {
   available;
   blocked;
 };
type ServiceListingInput = 
 record {
   active: bool;
   category: ServiceCategory;
   description: text;
   photos: vec ExternalBlob;
   priceCents: nat;
   priceUnit: text;
   serviceArea: text;
   title: text;
 };
type ServiceListing = 
 record {
   active: bool;
   category: ServiceCategory;
   createdAt: Timestamp;
   description: text;
   id: nat;
   photos: vec ExternalBlob;
   priceCents: nat;
   priceUnit: text;
   providerId: nat;
   serviceArea: text;
   title: text;
   updatedAt: Timestamp;
 };
type ServiceCategory = 
 variant {
   boxTruck;
   moving;
   relocation;
   trashHaul;
 };
type SearchResult = 
 record {
   listing: ServiceListing;
   provider: Provider;
 };
type SearchFilters = 
 record {
   availableOn: opt text;
   category: opt ServiceCategory;
   keyword: opt text;
   maxPriceCents: opt nat;
   minRating: opt nat;
   serviceArea: opt text;
 };
type ReviewInput = 
 record {
   bookingId: nat;
   rating: nat;
   writtenText: text;
 };
type Review = 
 record {
   bookingId: nat;
   createdAt: Timestamp;
   customerId: UserId;
   hidden: bool;
   id: nat;
   providerId: nat;
   providerResponse: opt text;
   rating: nat;
   updatedAt: Timestamp;
   writtenText: text;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ProviderInput = 
 record {
   companyName: text;
   description: opt text;
   logo: opt ExternalBlob;
   serviceAreas: vec text;
   serviceCategories: vec ServiceCategory;
 };
type Provider = 
 record {
   companyName: text;
   createdAt: Timestamp;
   description: opt text;
   id: nat;
   logo: opt ExternalBlob;
   ownerPrincipal: UserId;
   ratingCount: nat;
   ratingSum: nat;
   serviceAreas: vec text;
   serviceCategories: vec ServiceCategory;
   updatedAt: Timestamp;
   verificationNote: opt text;
   verificationStatus: VerificationStatus;
 };
type MessageInput = 
 record {
   bookingId: nat;
   content: text;
 };
type Message = 
 record {
   bookingId: nat;
   content: text;
   id: nat;
   read: bool;
   sender: UserId;
   sentAt: Timestamp;
 };
type MarketplaceRole = 
 variant {
   admin;
   customer;
   provider;
 };
type IdentitySource = 
 variant {
   email;
   google;
   internetIdentity;
 };
type IdentityAttributes = 
 record {
   displayName: opt text;
   email: opt text;
   firstSeenAt: nat;
   lastSeenAt: nat;
   "principal": AuthId;
   source: IdentitySource;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type BookingStatus = 
 variant {
   accepted;
   cancelled;
   completed;
   inProgress;
   requested;
   reviewed;
   scheduled;
 };
type BookingInput = 
 record {
   address: text;
   customerNote: opt text;
   jobDetails: text;
   listingId: nat;
   scheduledDate: text;
   scheduledTime: opt text;
 };
type Booking = 
 record {
   address: text;
   category: ServiceCategory;
   createdAt: Timestamp;
   customerId: UserId;
   customerNote: opt text;
   id: nat;
   jobDetails: text;
   listingId: nat;
   providerId: nat;
   scheduledDate: text;
   scheduledTime: opt text;
   status: BookingStatus;
   updatedAt: Timestamp;
 };
type AvailabilitySlotInput = 
 record {
   date: text;
   status: SlotStatus;
   time: opt text;
 };
type AvailabilitySlot = 
 record {
   createdAt: Timestamp;
   date: text;
   id: nat;
   providerId: nat;
   status: SlotStatus;
   time: opt text;
 };
type AuthId = principal;
service : {
  __accessControlState: () -> (reserved) query;
  __bookings: () -> (reserved) query;
  __identities: () -> (reserved) query;
  __listings: () -> (reserved) query;
  __messages: () -> (reserved) query;
  __nextBookingId: () -> (reserved) query;
  __nextListingId: () -> (reserved) query;
  __nextMessageId: () -> (reserved) query;
  __nextProviderId: () -> (reserved) query;
  __nextReviewId: () -> (reserved) query;
  __nextSlotId: () -> (reserved) query;
  __openAIApiKey: () -> (reserved) query;
  __providers: () -> (reserved) query;
  __reviews: () -> (reserved) query;
  __slots: () -> (reserved) query;
  __users: () -> (reserved) query;
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  acceptBooking: (bookingId: nat) -> (Booking);
  approveProvider: (providerId: nat) -> (Provider);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  blockAvailabilitySlot: (slotId: nat) -> (AvailabilitySlot);
  cancelBooking: (bookingId: nat) -> (Booking);
  checkAvailability: (providerId: nat, date: text, time: opt text) ->
   (bool) query;
  completeBooking: (bookingId: nat) -> (Booking);
  createBooking: (input: BookingInput) -> (Booking);
  createListing: (input: ServiceListingInput) -> (ServiceListing);
  createReview: (input: ReviewInput) -> (Review);
  declineBooking: (bookingId: nat) -> (Booking);
  deleteListing: (listingId: nat) -> ();
  execute: (qJson: text) -> (Result) query;
  generateListingDescription: (bulletPoints: text) -> (text);
  generatePromotionalContent: (offerDetails: text) -> (text);
  generateTitleAndTagline: (keywords: text) -> (vec text);
  getBooking: (bookingId: nat) -> (opt Booking) query;
  getCallerUserRole: () -> (UserRole) query;
  getListing: (listingId: nat) -> (opt ServiceListing) query;
  getMyBooking: (bookingId: nat) -> (opt Booking) query;
  getMyDisplayName: () -> (opt text) query;
  getMyEmail: () -> (opt text) query;
  getMyIdentity: () -> (opt IdentityAttributes) query;
  getMyIdentitySource: () -> (opt IdentitySource) query;
  getMyProvider: () -> (opt Provider) query;
  getMyUser: () -> (opt User) query;
  getProvider: (providerId: nat) -> (opt Provider) query;
  getReview: (reviewId: nat) -> (opt Review) query;
  getThread: (bookingId: nat) -> (vec Message) query;
  getUnreadMessageCount: (bookingId: nat) -> (nat) query;
  getUser: (userId: UserId) -> (opt User) query;
  isCallerAdmin: () -> (bool) query;
  isOpenAIConfigured: () -> (bool) query;
  listAvailabilitySlots: (providerId: nat) -> (vec AvailabilitySlot) query;
  listListingsByCategory: (category: ServiceCategory) ->
   (vec ServiceListing) query;
  listListingsByProvider: (providerId: nat) -> (vec ServiceListing) query;
  listMyBookings: () -> (vec Booking) query;
  listProviderBookings: (providerId: nat) -> (vec Booking) query;
  listProviders: () -> (vec Provider) query;
  listProvidersByCategory: (category: ServiceCategory) ->
   (vec Provider) query;
  listReviewsByBooking: (bookingId: nat) -> (vec Review) query;
  listReviewsByProvider: (providerId: nat) -> (vec Review) query;
  listUsers: () -> (vec User) query;
  markThreadRead: (bookingId: nat) -> ();
  moderateReview: (reviewId: nat, action: variant {
                                            hide;
                                            restore;
                                          }) -> (Review);
  registerProvider: (input: ProviderInput) -> (Provider);
  reinstateProvider: (providerId: nat) -> (Provider);
  rejectProvider: (providerId: nat, note: text) -> (Provider);
  respondToReview: (reviewId: nat, response: text) -> (Review);
  scheduleBooking: (bookingId: nat) -> (Booking);
  schema: () -> (text) query;
  searchProviders: (filters: SearchFilters) -> (vec SearchResult) query;
  sendMessage: (input: MessageInput) -> (Message);
  setAvailabilitySlot: (input: AvailabilitySlotInput) -> (AvailabilitySlot);
  setOpenAIApiKey: (key: text) -> ();
  startBooking: (bookingId: nat) -> (Booking);
  suspendProvider: (providerId: nat, note: text) -> (Provider);
  updateListing: (listingId: nat, input: ServiceListingInput) ->
   (ServiceListing);
  updateMyProvider: (input: ProviderInput) -> (Provider);
  upsertMyUser: (input: UserInput) -> (User);
}
