type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type VerificationTiers = 
 record {
   background: VerificationTierRecord;
   business: VerificationTierRecord;
   identity: VerificationTierRecord;
   insurance: VerificationTierRecord;
 };
type VerificationTierStatus = 
 variant {
   approved;
   expired;
   pending;
   rejected;
   unverified;
 };
type VerificationTierRecord = 
 record {
   note: opt text;
   status: VerificationTierStatus;
   verifiedAt: opt Timestamp;
 };
type VerificationStatus = 
 variant {
   approved;
   pending;
   rejected;
   suspended;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserInput = 
 record {
   avatar: opt ExternalBlob;
   displayName: text;
   email: opt text;
   phone: opt text;
   role: MarketplaceRole;
   workPhotos: vec ExternalBlob;
 };
type UserId = principal;
type User = 
 record {
   avatar: opt ExternalBlob;
   createdAt: Timestamp;
   displayName: text;
   email: opt text;
   phone: opt text;
   "principal": UserId;
   role: MarketplaceRole;
   updatedAt: Timestamp;
   workPhotos: vec ExternalBlob;
 };
type TrustScore = 
 record {
   disputeHistory: nat;
   longevity: nat;
   overall: nat;
   responsiveness: nat;
   reviews: nat;
   updatedAt: Timestamp;
   verification: nat;
 };
type Tone = 
 variant {
   concise;
   friendly;
   professional;
 };
type Timestamp = int;
type SlotStatus = 
 variant {
   available;
   blocked;
 };
type ServiceListingInput = 
 record {
   active: bool;
   category: ServiceCategory;
   description: text;
   photos: vec ExternalBlob;
   priceCents: nat;
   priceUnit: text;
   serviceArea: text;
   title: text;
 };
type ServiceListing = 
 record {
   active: bool;
   category: ServiceCategory;
   createdAt: Timestamp;
   description: text;
   id: nat;
   photos: vec ExternalBlob;
   priceCents: nat;
   priceUnit: text;
   providerId: nat;
   serviceArea: text;
   title: text;
   updatedAt: Timestamp;
 };
type ServiceCategory = 
 variant {
   boxTruck;
   moving;
   relocation;
   trashHaul;
 };
type SeedResult = 
 record {
   listingOutcomes: vec SeedListingOutcome;
   providerCreated: bool;
   providerId: nat;
 };
type SeedListingOutcome = 
 record {
   category: variant {
               boxTruck;
               moving;
               relocation;
               trashHaul;
             };
   outcome: variant {
              created;
              skipped;
            };
 };
type SearchResult = 
 record {
   listing: ServiceListing;
   provider: Provider;
 };
type SearchFilters = 
 record {
   availableOn: opt text;
   category: opt ServiceCategory;
   keyword: opt text;
   maxPriceCents: opt nat;
   minRating: opt nat;
   serviceArea: opt text;
 };
type RewardTier = 
 variant {
   bronze;
   gold;
   platinum;
   silver;
 };
type RewardProfile = 
 record {
   badges: vec text;
   points: nat;
   referralCode: text;
   streak: nat;
   tier: RewardTier;
   updatedAt: Timestamp;
   userId: UserId;
 };
type RewardLedgerEntry = 
 record {
   id: nat;
   points: nat;
   reason: text;
   timestamp: Timestamp;
   userId: UserId;
 };
type ReviewSummary = 
 record {
   providerId: nat;
   sentiment: text;
   summary: text;
   themes: vec text;
 };
type ReviewInput = 
 record {
   bookingId: nat;
   rating: nat;
   writtenText: text;
 };
type Review = 
 record {
   bookingId: nat;
   createdAt: Timestamp;
   customerId: UserId;
   hidden: bool;
   id: nat;
   providerId: nat;
   providerResponse: opt text;
   rating: nat;
   updatedAt: Timestamp;
   writtenText: text;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ReportTargetType = 
 variant {
   listing;
   provider;
   review;
   user;
 };
type ReportStatus = 
 variant {
   dismissed;
   open;
   resolved;
   reviewing;
 };
type ReferralStatus = 
 variant {
   awarded;
   expired;
   pending;
 };
type Referral = 
 record {
   awardedAt: opt Timestamp;
   createdAt: Timestamp;
   id: nat;
   referee: UserId;
   referrer: UserId;
   status: ReferralStatus;
 };
type ProviderMatch = 
 record {
   providerId: nat;
   rationale: text;
   score: nat;
 };
type ProviderInsights = 
 record {
   insights: text;
   providerId: nat;
   recommendations: vec text;
 };
type ProviderInput = 
 record {
   companyName: text;
   description: opt text;
   logo: opt ExternalBlob;
   serviceAreas: vec text;
   serviceCategories: vec ServiceCategory;
 };
type Provider = 
 record {
   companyName: text;
   createdAt: Timestamp;
   description: opt text;
   id: nat;
   logo: opt ExternalBlob;
   ownerPrincipal: UserId;
   ratingCount: nat;
   ratingSum: nat;
   serviceAreas: vec text;
   serviceCategories: vec ServiceCategory;
